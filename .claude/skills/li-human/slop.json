      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Reflex engagement bait",
      "fix": "Ask a question only you could ask, about the specific thing above it."
    },
    {
      "id": "fr-ce-nest-pas",
      "name": "\"Ce n'est pas X, c'est Y\" (FR)",
      "regex": "(?i)\\bce n'?est pas (?:juste |seulement |qu'?)?[^.!?\\n]{2,60}[,.] c'?est\\b",
      "fix": "Dis la seule chose que tu penses vraiment. Supprime la première moitié.",
      "lang": "fr"
    },
    {
      "id": "fr-non-seulement",
      "name": "\"Non seulement X mais aussi Y\" (FR)",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
      "fix": "Garde le second membre. Le premier ne sert qu'à équilibrer la phrase.",
      "lang": "fr"
